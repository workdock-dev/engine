# syntax=docker/dockerfile:1
FROM postgres:16-bookworm AS pg-cron-build
ARG PG_CRON_VERSION=1.6.2
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates git postgresql-server-dev-16 \
    && git clone --depth 1 --branch "v${PG_CRON_VERSION}" https://github.com/citusdata/pg_cron.git /tmp/pg_cron \
    && make -C /tmp/pg_cron \
    && make -C /tmp/pg_cron install \
    && rm -rf /var/lib/apt/lists/* /tmp/pg_cron

FROM postgres:16-bookworm
COPY --from=pg-cron-build /usr/lib/postgresql/16/lib/pg_cron.so /usr/lib/postgresql/16/lib/pg_cron.so
COPY --from=pg-cron-build /usr/share/postgresql/16/extension/pg_cron* /usr/share/postgresql/16/extension/
COPY docker/postgres/init/ /docker-entrypoint-initdb.d/
# pg_cron must load before the engine migration creates its extension.
CMD ["postgres", "-c", "shared_preload_libraries=pg_cron", "-c", "cron.database_name=workdock"]
