# Copy to .env and replace values before exposing this deployment.
# Generate values with `openssl rand -hex 16` and `openssl rand -base64 32`.
POSTGRES_PASSWORD=workdock
INFISICAL_ENCRYPTION_KEY=replace-with-32-character-hex-key
INFISICAL_AUTH_SECRET=replace-with-random-base64-secret
INFISICAL_SITE_URL=http://localhost:8081
SIGNOZ_JWT_SECRET=replace-with-a-long-random-secret
INFISICAL_IMAGE=infisical/infisical:latest

# Required to render docker/workdock/config.yaml after Infisical is initialized.
# The three WORKDOCK_INFISICAL_* values become available after creating an
# Infisical project and Universal Auth client at http://localhost:8081.
WORKDOCK_LINEAR_SERVER_URL=http://localhost:8080
WORKDOCK_LINEAR_WEBHOOK_SECRET=
WORKDOCK_LINEAR_CLIENT_ID=
WORKDOCK_LINEAR_CLIENT_SECRET=
WORKDOCK_GITHUB_BOT_LOGIN_ID=workdock[bot]
WORKDOCK_GITHUB_CLIENT_ID=
WORKDOCK_GITHUB_WEBHOOK_SECRET=
WORKDOCK_DAYTONA_API_URL=https://app.daytona.io/api
WORKDOCK_DAYTONA_API_KEY=
WORKDOCK_DAYTONA_TARGET=us
WORKDOCK_OPENCODE_MODEL=
WORKDOCK_INFISICAL_CLIENT_ID=
WORKDOCK_INFISICAL_CLIENT_SECRET=
WORKDOCK_INFISICAL_PROJECT_ID=
WORKDOCK_INFISICAL_ENVIRONMENT=dev
